NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ledger:ledger@localhost:5432/ledger?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-prod-min-16-chars
JWT_EXPIRES_IN=1h
AUTH_RATE_MAX=5
TRANSFER_RATE_MAX=30
CORS_ORIGINS=

# Optional. If set, the seed script creates a login-capable ADMIN user
# (admin@ledger.local) with this password. If omitted, no admin user is
# seeded — the treasury account and transfers between existing accounts
# still work; only admin-only endpoints (deposits) stay unreachable until
# an admin is provisioned.
ADMIN_PASSWORD=
